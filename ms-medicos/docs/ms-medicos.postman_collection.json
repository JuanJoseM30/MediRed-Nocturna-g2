    {
      "name": "7. Crear medico -> 201",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset('id_creado');",
              "pm.collectionVariables.set('registro_prueba', 'RM-T3-' + Date.now() + '-' + Math.floor(Math.random() * 100000));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "  const medico = pm.response.json();",
              "  pm.test('Devuelve id y registro', function () {",
              "    pm.expect(medico.id).to.be.a('number');",
              "    pm.expect(medico.registro_medico).to.eql(pm.collectionVariables.get('registro_prueba'));",
              "  });",
              "  if (medico.id) pm.collectionVariables.set('id_creado', String(medico.id));",
              "}"
            ]
          }
        }
      ],
