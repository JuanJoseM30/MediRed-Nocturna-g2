{
  "info": {
    "_postman_id": "a87cd85b-42a3-4422-983e-463086673916",
    "name": "ms-medicos - Taller 3 - gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "43476995",
    "description": "Coleccion manual, sin scripts. Ejecutar primero 0a, 0b y 0c; copiar cada token a las variables token_admin, token_admisiones y token_medico. Escribir las contrasenas solo en Postman y no exportarlas al repositorio. Los casos 7 a 13 suponen tres medicos iniciales y que el nuevo medico reciba el id 4. El caso 18 crea un medico adicional."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token_admin}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0a. Login administrador -> 200",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/usuarios/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "response": []
    },
    {
