{
  "info": {
    "_postman_id": "a87cd85b-42a3-4422-983e-463086673916",
    "name": "ms-medicos - Taller 3 - gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "43476995",
    "description": "Ejecutar con Run desde el PC que resuelve app.medired.com. Antes, configurar en Postman las variables admin_password, admisiones_password y medico_password con las claves actuales; no subir esas claves a GitHub. Los tres logins guardan los tokens automaticamente. Ejecutar la coleccion en orden. El caso 18 crea un medico adicional para demostrar el permiso del administrador. La ruta /health no pasa por el gateway; se verifica localmente en servidor2."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token_admin}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0a. Login administrador -> 200",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset('token_admin');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "  const datos = pm.response.json();",
              "  pm.test('Entrega token', function () {",
              "    pm.expect(datos.token).to.be.a('string').and.not.empty;",
              "  });",
              "  if (datos.token) pm.collectionVariables.set('token_admin', datos.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/usuarios/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
