# Copie este archivo como .env y ajuste los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Puerto donde escucha este microservicio.
# ms-usuarios usa el 3001; los microservicios de los estudiantes, del 3002 en adelante.
PORT=3005
# 127.0.0.1 = solo acepta conexiones desde el mismo equipo (el gateway Apache estará en ese mismo equipo)
HOST=127.0.0.1

# Base de datos MySQL del microservicio (en su PC: localhost)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=historias_db
DB_USER=historias_user
DB_PASSWORD=cambie-esta-clave

# Clave con la que se verifican los tokens JWT.
# DEBE SER LA MISMA que en ms-usuarios y en todos los microservicios del grupo.
JWT_SECRET=coloque-aqui-la-clave-del-grupo
