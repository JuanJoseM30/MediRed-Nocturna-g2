# /etc/systemd/system/ms-medicos.service (servidor2)
[Unit]
Description=Microservicio medicos - MediRed
After=network.target

[Service]
User=nodeapps
Group=nodeapps
WorkingDirectory=/srv/medired/app/ms-medicos
ExecStart=/usr/bin/node --env-file=.env src/index.js
Restart=on-failure

[Install]
WantedBy=multi-user.target